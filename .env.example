# Copy this file to ".env" and fill in your own values.
# ".env" itself is gitignored so your real keys never get committed.

# Required: your Google Gemini API key, used to generate the plain-language
# briefing. Get one for free (no credit card required) at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: only needed if you've registered for a NOTAM data provider
# (e.g. the FAA's NOTAM API, or a third-party SWIM-based provider).
# If left blank, the app simply skips the NOTAM section and leans more
# heavily on weather + flight-plan context in the briefing - this is
# expected behavior, not an error.
NOTAM_API_URL=
NOTAM_API_KEY=